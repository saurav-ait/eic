# ============================================
# MAILGUN EMAIL CONFIGURATION
# ============================================
# Copy these lines to your .env file and update with your credentials

# Mail Driver
MAIL_MAILER=mailgun

# From Address (Your sending email)
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun Credentials
# Get these from: https://app.mailgun.com/
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_SECRET=key-1234567890abcdef1234567890abcdef
MAILGUN_ENDPOINT=api.mailgun.net

# For EU region, use:
# MAILGUN_ENDPOINT=api.eu.mailgun.net

# ============================================
# HOW TO GET CREDENTIALS
# ============================================
# 1. Login to Mailgun: https://app.mailgun.com/
# 2. Go to "Sending" → "Domains" to get your domain
# 3. Go to "Settings" → "API Keys" to get your secret key
# 4. Copy the Private API key (starts with "key-")

# ============================================
# EXAMPLE CONFIGURATION
# ============================================
# MAIL_MAILER=mailgun
# MAIL_FROM_ADDRESS=support@immigrationservices.com
# MAIL_FROM_NAME="Immigration Services"
# MAILGUN_DOMAIN=mg.immigrationservices.com
# MAILGUN_SECRET=key-abc123def456ghi789jkl012mno345pqr
# MAILGUN_ENDPOINT=api.mailgun.net
